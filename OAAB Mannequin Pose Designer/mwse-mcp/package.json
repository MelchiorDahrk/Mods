{
  "name": "mwse-mcp",
  "version": "0.1.0",
  "description": "MCP server bridging an AI agent to a running Morrowind/MWSE instance.",
  "type": "module",
  "bin": {
    "mwse-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "build:api-index": "if not exist data mkdir data && lua scripts/build-api-index.lua \"%MWSE_AUTOCOMPLETE%\" > data/api-index.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "install:mcp": "node scripts/install.mjs",
    "uninstall:mcp": "node scripts/install.mjs uninstall",
    "package": "node scripts/package.mjs",
    "verify:api-lookup": "node scripts/verify-api-lookup.mjs",
    "verify:wait": "node scripts/verify-wait.mjs",
    "test:install-pi": "node --test scripts/test-install-pi.mjs",
    "test:install-freebuff": "node --test scripts/test-install-freebuff.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0",
    "smol-toml": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
