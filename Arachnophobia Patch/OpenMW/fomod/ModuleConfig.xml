<?xml version='1.0' encoding='utf-8'?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
	<moduleName>Arachnophobia Patch - OpenMW</moduleName>
	<moduleImage path="fomod\images\header.png" />
	<requiredInstallFiles>
		<file source="Arachnophobia Patch.txt" destination="Arachnophobia Patch.txt" priority="0" />
	</requiredInstallFiles>
	<installSteps order="Explicit">
		<installStep name="Options">
			<optionalFileGroups order="Explicit">
				<group name="Runtime" type="SelectExactlyOne">
					<plugins order="Explicit">
						<plugin name="Static Switching System replacements">
							<description>Replaces ordinary creatures using Static Switching System instance rules. Requires SSS with instance support and H3lp Yours3lf, with both plugins enabled. Also installs the mesh fallbacks. Quest-sensitive creatures, corpses, and respawning actors keep their original records. See the readme for setup and save limitations.</description>
							<conditionFlags>
								<flag name="runtime">On</flag>
							</conditionFlags>
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
						<plugin name="Visual replacements only">
							<description>Installs replacement meshes and optional moss textures for OpenMW. Creatures keep their original records and behavior. No runtime replacement framework is required.</description>
							<files />
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
					</plugins>
				</group>
				<group name="Webs" type="SelectExactlyOne">
					<plugins order="Explicit">
						<plugin name="Replace with moss">
							<description />
							<files>
								<folder source="00 Visual Replacements\Textures" destination="Textures" priority="0" />
							</files>
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
						<plugin name="Don't change">
							<description />
							<files />
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
					</plugins>
				</group>
			</optionalFileGroups>
		</installStep>
		<installStep name="Creature Replacements">
			<optionalFileGroups order="Explicit">
				<group name="Options" type="SelectAny">
					<plugins order="Explicit">
						<plugin name="Vanilla">
							<description>Includes spider centurions. Quest variants use a scarab mesh while keeping their original records.</description>
							<conditionFlags>
								<flag name="vanilla">On</flag>
							</conditionFlags>
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
						<plugin name="OAAB_Data">
							<description>Includes spiders and the web-trap script patch. Requires OAAB_Data, Tribunal, and Bloodmoon. Enable ArachnophobiaPatch_OAAB.ESP after OAAB_Data.esm. In OpenMW, respawning parasol spiders use the mudcrab mesh fallback.</description>
							<conditionFlags>
								<flag name="oaab">On</flag>
							</conditionFlags>
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
						<plugin name="Tamriel_Data">
							<description>Includes spiders, dridrea, and spider daedra. Requires Tamriel_Data. Quest creatures and Spider Daedra Matriarchs needed for soul-gem quests use mudcrab meshes while keeping their original records.</description>
							<conditionFlags>
								<flag name="tamriel">On</flag>
							</conditionFlags>
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
					</plugins>
				</group>
			</optionalFileGroups>
		</installStep>
	</installSteps>
	<conditionalFileInstalls>
		<patterns>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="vanilla" value="On" />
				</dependencies>
				<files>
					<folder source="00 Visual Replacements\Meshes\r" destination="Meshes\r" priority="0" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="oaab" value="On" />
				</dependencies>
				<files>
					<folder source="00 Visual Replacements\Meshes\oaab" destination="Meshes\oaab" priority="0" />
					<file source="01 OAAB_Data Creature Replacements\ArachnophobiaPatch_OAAB.ESP" destination="ArachnophobiaPatch_OAAB.ESP" priority="0" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="tamriel" value="On" />
				</dependencies>
				<files>
					<folder source="00 Visual Replacements\Meshes\tr" destination="Meshes\tr" priority="0" />
					<folder source="00 Visual Replacements\Meshes\sky" destination="Meshes\sky" priority="0" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="runtime" value="On" />
					<flagDependency flag="vanilla" value="On" />
				</dependencies>
				<files>
					<folder source="03 Vanilla Spider Centurions Replacements\scripts" destination="scripts" priority="0" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="runtime" value="On" />
					<flagDependency flag="oaab" value="On" />
				</dependencies>
				<files>
					<folder source="01 OAAB_Data Creature Replacements\scripts" destination="scripts" priority="0" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="runtime" value="On" />
					<flagDependency flag="tamriel" value="On" />
				</dependencies>
				<files>
					<folder source="02 Tamriel_Data Creature Replacements\scripts" destination="scripts" priority="0" />
				</files>
			</pattern>
		</patterns>
	</conditionalFileInstalls>
</config>