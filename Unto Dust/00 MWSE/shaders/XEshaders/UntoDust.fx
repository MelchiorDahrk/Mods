// Generated by tools/build_shaders.py. Edit shaders/ instead.
// Disable underwater (8). Burial-cell selection is controlled by MWSE.
int mgeflags = 8;
float dustDensity = 0.32;
float dustTime = 0.0;
float3 eyepos;
float2 rcpres;
matrix mview;
matrix mproj;
texture lastshader;
texture depthframe;
sampler sceneSampler = sampler_state {
    texture = <lastshader>; addressu = clamp; addressv = clamp;
    minfilter = point; magfilter = point;
};
sampler depthSampler = sampler_state {
    texture = <depthframe>; addressu = clamp; addressv = clamp;
    minfilter = point; magfilter = point;
};
texture dustTexture < string src = "UntoDust/dust.dds"; >;
sampler dustSampler = sampler_state {
    texture = <dustTexture>; addressu = clamp; addressv = clamp;
    minfilter = linear; magfilter = linear; mipfilter = linear;
};

float4 dustSampleTexture(float2 uv, float lod)
{
    return tex2Dlod(dustSampler, float4(uv, 0.0, lod));
}

// Shared textured dust implementation. tools/build_shaders.py embeds this
// in GLSL (OpenMW) and translates the small common subset to HLSL (MGE XE).
// The wrappers provide dustSampleTexture; no meshes or history buffers are used.
float3 dustHash(float3 p)
{
    p = frac(p * float3(0.1031, 0.1030, 0.0973));
    p += dot(p, p.yxz + 33.33);
    return frac((p.xxy + p.yxx) * p.zyx);
}

// Rotate a flake's local X/Y axes around all three world axes. Each mote has
// stable phases, speeds, and directions; a full turn takes roughly 50-100 s.
void dustAxes(float3 seed, float seconds, out float3 axisU, out float3 axisV)
{
    float3 speed = lerp(float3(0.065, 0.075, 0.060), float3(0.115, 0.125, 0.105), seed);
    speed *= step(float3(0.5, 0.5, 0.5), seed.zxy) * 2.0 - 1.0;
    float3 angle = seed * 6.2831853 + seconds * speed;
    float3 s = sin(angle);
    float3 c = cos(angle);
    axisU = float3(c.z * c.y, s.z * c.y, -s.y);
    axisV = float3(c.z * s.y * s.x - s.z * c.x,
                 s.z * s.y * s.x + c.z * c.x, c.y * s.x);
}

float4 dustMotes(float3 eye, float3 ray, float sceneDistance,
                float pixelAngle, float seconds, float density)
{
    const float cellSize = 96.0;
    const float nearDistance = 12.0;
    const float farDistance = 768.0;
    float endDistance = min(sceneDistance, farDistance);
    if (endDistance <= nearDistance)
        return float4(0.0, 0.0, 0.0, 0.0);

    // Traverse only the grid cells actually crossed by this pixel's ray.
    // 20 steps cover the worst-case diagonal through the 768-unit volume.
    float3 start = eye + ray * nearDistance;
    float3 cell = floor(start / cellSize);
    float3 direction = step(float3(0.0, 0.0, 0.0), ray) * 2.0 - 1.0;
    float3 inverseRay = direction / max(abs(ray), float3(0.000001, 0.000001, 0.000001));
    float3 boundary = (cell + step(float3(0.0, 0.0, 0.0), ray)) * cellSize;
    float3 nextCrossing = (boundary - start) * inverseRay + nearDistance;
    float3 crossingDelta = abs(inverseRay) * cellSize;
    float entered = nearDistance;
    // Front-to-back premultiplied color, with coverage in alpha.
    float4 dust = float4(0.0, 0.0, 0.0, 0.0);

    for (int i = 0; i < 20; ++i)
    {
        if (entered >= endDistance)
            break;

        float3 seed = dustHash(cell);
        if (frac(seed.x * 17.0 + seed.y * 29.0) < density)
        {
            // Keep centers well inside their cells, including all drift.
            // This avoids popping at cell boundaries and camera movement.
            float3 drift = sin(seed * 6.2831853 + seconds * float3(0.31, 0.23, 0.17)) * 0.08;
            float3 center = (cell + 0.2 + seed * 0.6 + drift) * cellSize;
            float3 offset = center - eye;
            float along = dot(offset, ray);
            float3 perpendicular = offset - along * ray;
            // Include the transparent border of the original dust texture.
            float radius = lerp(0.8, 2.0, seed.z);
            float footprint = max(radius, along * pixelAngle * 0.75);
            // Reject pixels outside the flake's bounding sphere before trig
            // and texture work. The image, rather than this bound, sets shape.
            if (along > nearDistance && along < endDistance + footprint &&
                dot(perpendicular, perpendicular) < 2.0 * footprint * footprint)
            {
                float3 axisU, axisV;
                dustAxes(seed, seconds, axisU, axisV);
                float3 normal = cross(axisU, axisV);
                float facing = dot(ray, normal);
                // Intersect the ray with the actual rotating plane. This
                // foreshortens and flips the image as the flake turns over.
                if (abs(facing) > 0.001)
                {
                    float hit = dot(offset, normal) / facing;
                    float3 local = ray * hit - offset;
                    float2 uv = float2(dot(local, axisU), dot(local, axisV)) / (2.0 * footprint) + 0.5;
                    if (uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0)
                    {
                        // Explicit LOD works inside divergent loops on SM3.
                        // Preserve coverage when a flake is below pixel size.
                        float lod = max(0.0, log2(128.0 * max(along * pixelAngle, 0.00001) /
                                                  (footprint * max(abs(facing), 0.01))));
                        float4 texel = dustSampleTexture(uv, lod);
                        float visibility = smoothstep(nearDistance, 36.0, hit);
                        visibility *= 1.0 - smoothstep(512.0, farDistance, hit);
                        visibility *= clamp((sceneDistance - hit - 0.5) / 4.0, 0.0, 1.0);
                        float mote = texel.a * visibility * 0.85;
                        mote *= radius * radius / (footprint * footprint);
                        dust += (1.0 - dust.a) * float4(texel.rgb * mote, mote);
                    }
                }
            }
        }

        float crossing = min(nextCrossing.x, min(nextCrossing.y, nextCrossing.z));
        // Advance all tied axes, including rays exactly on edges/corners.
        float3 axes = step(nextCrossing, float3(crossing, crossing, crossing));
        cell += axes * direction;
        nextCrossing += axes * crossingDelta;
        entered = crossing;
    }
    return dust;
}

float3 dustComposite(float3 scene, float4 dust)
{
    // Approximate illumination from the scene: subtle motes in dark rooms,
    // brighter in lit rooms. This is not a local-light or shadow simulation.
    float illumination = clamp(dot(scene, float3(0.2126, 0.7152, 0.0722)) * 2.2 + 0.06, 0.06, 1.0);
    // Lift the dark source albedo so the textured motes remain visible.
    return scene * (1.0 - dust.a) + dust.rgb * (1.6 * illumination);
}


float4 dust(float2 uv : TEXCOORD0) : COLOR0
{
    float4 scene = tex2D(sceneSampler, uv);
    // MGE XE's depthframe contains linear view-axis distance in game units.
    // The view rotation columns transform the D3D ray back into world space.
    float3 viewRay = float3((2.0 * uv.x - 1.0) / mproj[0][0],
                           (1.0 - 2.0 * uv.y) / mproj[1][1], 1.0);
    float rayLength = length(viewRay);
    float3 ray = normalize(mul(viewRay, transpose((float3x3)mview)));
    float distance = tex2D(depthSampler, uv).r * rayLength;
    float pixelAngle = 2.0 * rcpres.y / abs(mproj[1][1]);
    float4 motes = dustMotes(eyepos, ray, distance, pixelAngle, dustTime, dustDensity);
    return float4(dustComposite(scene.rgb, motes), scene.a);
}

technique T0 < string MGEinterface = "MGE XE 0"; string category = "scene"; >
{
    pass { PixelShader = compile ps_3_0 dust(); }
}
