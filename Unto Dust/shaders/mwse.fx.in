// Generated by tools/build_shaders.py. Edit shaders/ instead.
// Disable underwater (8). Burial-cell selection is controlled by MWSE.
int mgeflags = 8;
float dustDensity = 0.32;
float dustTime = 0.0;
float3 eyepos;
float2 rcpres;
matrix mview;
matrix mproj;
texture lastshader;
texture depthframe;
sampler sceneSampler = sampler_state {
    texture = <lastshader>; addressu = clamp; addressv = clamp;
    minfilter = point; magfilter = point;
};
sampler depthSampler = sampler_state {
    texture = <depthframe>; addressu = clamp; addressv = clamp;
    minfilter = point; magfilter = point;
};
texture dustTexture < string src = "UntoDust/dust.dds"; >;
sampler dustSampler = sampler_state {
    texture = <dustTexture>; addressu = clamp; addressv = clamp;
    minfilter = linear; magfilter = linear; mipfilter = linear;
};

float4 dustSampleTexture(float2 uv, float lod)
{
    return tex2Dlod(dustSampler, float4(uv, 0.0, lod));
}

@CORE@

float4 dust(float2 uv : TEXCOORD0) : COLOR0
{
    float4 scene = tex2D(sceneSampler, uv);
    // MGE XE's depthframe contains linear view-axis distance in game units.
    // The view rotation columns transform the D3D ray back into world space.
    float3 viewRay = float3((2.0 * uv.x - 1.0) / mproj[0][0],
                           (1.0 - 2.0 * uv.y) / mproj[1][1], 1.0);
    float rayLength = length(viewRay);
    float3 ray = normalize(mul(viewRay, transpose((float3x3)mview)));
    float distance = tex2D(depthSampler, uv).r * rayLength;
    float pixelAngle = 2.0 * rcpres.y / abs(mproj[1][1]);
    float4 motes = dustMotes(eyepos, ray, distance, pixelAngle, dustTime, dustDensity);
    return float4(dustComposite(scene.rgb, motes), scene.a);
}

technique T0 < string MGEinterface = "MGE XE 0"; string category = "scene"; >
{
    pass { PixelShader = compile ps_3_0 dust(); }
}
