uniform_float dustDensity { default = 0.32; static = false; }
uniform_float dustTime { default = 0.0; static = false; }

sampler_2d dustTexture {
    source = "textures/UntoDust/dust.dds";
    min_filter = linear_mipmap_linear;
    mag_filter = linear;
    wrap_s = clamp_to_edge;
    wrap_t = clamp_to_edge;
}

fragment dust {
    // Generated by tools/build_shaders.py. Edit shaders/ instead.
    omw_In vec2 omw_TexCoord;

    vec4 dustSampleTexture(vec2 uv, float lod)
    {
        // OpenMW flips DDS textures vertically at load time.
        return textureLod(dustTexture, vec2(uv.x, 1.0 - uv.y), lod);
    }

@CORE@

    void main()
    {
        vec4 scene = omw_GetLastShader(omw_TexCoord);
        // Reconstruct a ray independently of depth (also valid at sky pixels).
        vec4 view = omw.invProjectionMatrix * vec4(omw_TexCoord * 2.0 - 1.0, 0.5, 1.0);
        vec3 viewRay = normalize(view.xyz / view.w);
        vec3 ray = normalize((omw.invViewMatrix * vec4(viewRay, 0.0)).xyz);
        // Linear depth is distance along the view axis, not along this ray.
        float distance = omw_GetLinearDepth(omw_TexCoord) / max(-viewRay.z, 0.000001);
        float pixelAngle = 2.0 * omw.rcpResolution.y / abs(omw.projectionMatrix[1][1]);
        vec4 motes = dustMotes(omw.eyePos.xyz, ray, distance, pixelAngle, dustTime, dustDensity);
        omw_FragColor = vec4(dustComposite(scene.rgb, motes), scene.a);
    }
}

technique {
    passes = dust;
    description = "Unto Dust: drifting world-space burial dust";
    author = "Melchior Dahrk & Greatness7";
    version = "2.0";
    glsl_version = 330;
    dynamic = true;
    flags = hidden, disable_underwater;
}
